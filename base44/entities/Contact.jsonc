{
  "name": "Contact",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "landowner",
        "broker",
        "attorney",
        "consultant",
        "investor",
        "contractor",
        "government",
        "other"
      ],
      "default": "other"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_contacted": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "lead",
        "prospect"
      ],
      "default": "active"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}