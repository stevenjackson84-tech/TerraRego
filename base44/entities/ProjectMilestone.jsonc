{
  "name": "ProjectMilestone",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Related project ID"
    },
    "phase_id": {
      "type": "string",
      "description": "Related phase ID (optional)"
    },
    "name": {
      "type": "string",
      "description": "Milestone name"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "overdue"
      ],
      "default": "pending"
    },
    "assigned_to": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "name"
  ]
}