{
  "name": "ProjectExpense",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Related project ID"
    },
    "phase_id": {
      "type": "string",
      "description": "Related phase ID (optional)"
    },
    "category": {
      "type": "string",
      "enum": [
        "labor",
        "materials",
        "equipment",
        "permits",
        "professional_services",
        "utilities",
        "other"
      ],
      "default": "other"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "vendor": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "approved",
        "paid"
      ],
      "default": "planned"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "amount",
    "category"
  ]
}